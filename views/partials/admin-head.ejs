<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> - Admin EnElMapa</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'Segoe UI', system-ui, sans-serif; background: #F5F3EE; color: #1A1A18; }
  .sidebar { position: fixed; top: 0; left: 0; width: 240px; height: 100vh; background: #1A1917; color: #F0EDE6; display: flex; flex-direction: column; z-index: 50; }
  .sidebar-brand { padding: 20px; font-size: 18px; font-weight: 700; border-bottom: 1px solid #333; }
  .sidebar-brand span { color: #C8956C; }
  .sidebar-nav { flex: 1; padding: 12px 0; }
  .sidebar-link { display: flex; align-items: center; gap: 10px; padding: 10px 20px; color: #A8A295; text-decoration: none; font-size: 14px; transition: all 0.15s; }
  .sidebar-link:hover, .sidebar-link.active { color: #F0EDE6; background: rgba(200,149,108,0.12); }
  .sidebar-link.active { border-right: 3px solid #C8956C; }
  .sidebar-footer { padding: 16px 20px; border-top: 1px solid #333; font-size: 12px; color: #7A7568; }
  .sidebar-footer a { color: #C8956C; text-decoration: none; }
  .main { margin-left: 240px; min-height: 100vh; }
  .topbar { background: #fff; border-bottom: 1px solid #E8E5DE; padding: 14px 24px; display: flex; justify-content: space-between; align-items: center; }
  .topbar-title { font-size: 18px; font-weight: 700; }
  .topbar-user { font-size: 13px; color: #6B6860; }
  .topbar-user a { color: #C8956C; text-decoration: none; margin-left: 12px; }
  .content { padding: 24px; }
  .card { background: #fff; border-radius: 10px; border: 1px solid #E8E5DE; padding: 24px; margin-bottom: 20px; }
  .card h3 { font-size: 16px; margin-bottom: 16px; }
  .form-group { margin-bottom: 16px; }
  .form-group label { display: block; font-size: 13px; font-weight: 600; color: #6B6860; margin-bottom: 6px; }
  .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 9px 12px; border: 1px solid #E8E5DE; border-radius: 8px; font-family: inherit; font-size: 14px; outline: none; }
  .form-group input:focus, .form-group select:focus { border-color: #C8956C; }
  .form-group textarea { resize: vertical; min-height: 60px; }
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; border-radius: 8px; font-family: inherit; font-size: 14px; font-weight: 600; cursor: pointer; border: none; transition: all 0.15s; }
  .btn-primary { background: #C8956C; color: #fff; }
  .btn-primary:hover { background: #b8845c; }
  .btn-secondary { background: #F2EFEA; color: #1A1A18; }
  .btn-secondary:hover { background: #E8E5DE; }
  .btn-danger { background: #E74C3C; color: #fff; }
  .btn-danger:hover { background: #C0392B; }
  .btn-sm { padding: 6px 12px; font-size: 13px; }
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; margin-bottom: 24px; }
  .stat-card { background: #fff; border-radius: 10px; border: 1px solid #E8E5DE; padding: 20px; text-align: center; }
  .stat-num { font-size: 32px; font-weight: 700; color: #C8956C; }
  .stat-label { font-size: 13px; color: #6B6860; margin-top: 4px; }
  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; font-size: 12px; font-weight: 600; color: #9C9889; text-transform: uppercase; letter-spacing: 0.05em; padding: 8px 12px; border-bottom: 2px solid #E8E5DE; }
  td { padding: 10px 12px; border-bottom: 1px solid #E8E5DE; font-size: 14px; vertical-align: middle; }
  tr:last-child td { border-bottom: none; }
  .img-thumb { width: 40px; height: 40px; border-radius: 6px; object-fit: cover; background: #F2EFEA; }
  .toggle { position: relative; display: inline-block; width: 44px; height: 24px; }
  .toggle input { opacity: 0; width: 0; height: 0; }
  .toggle-slider { position: absolute; inset: 0; background: #E8E5DE; border-radius: 12px; cursor: pointer; transition: 0.2s; }
  .toggle-slider::before { content: ''; position: absolute; width: 18px; height: 18px; border-radius: 50%; background: #fff; left: 3px; top: 3px; transition: 0.2s; }
  .toggle input:checked + .toggle-slider { background: #C8956C; }
  .toggle input:checked + .toggle-slider::before { transform: translateX(20px); }
  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 100; display: none; align-items: center; justify-content: center; }
  .modal-overlay.open { display: flex; }
  .modal { background: #fff; border-radius: 12px; padding: 28px; width: 90%; max-width: 480px; max-height: 90vh; overflow-y: auto; }
  .modal h3 { margin-bottom: 20px; }
  .modal-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; }
  .img-preview { width: 120px; height: 80px; border-radius: 8px; object-fit: cover; background: #F2EFEA; margin-top: 8px; }
  .alert { padding: 12px 16px; border-radius: 8px; font-size: 14px; margin-bottom: 16px; }
  .alert-success { background: #D4EDDA; color: #155724; }
  @media (max-width: 768px) {
    .sidebar { width: 100%; height: auto; position: relative; }
    .sidebar-nav { display: flex; overflow-x: auto; padding: 0; }
    .sidebar-link { padding: 12px 16px; white-space: nowrap; border-right: none !important; }
    .sidebar-link.active { border-bottom: 2px solid #C8956C; }
    .main { margin-left: 0; }
    .sidebar-footer { display: none; }
  }
</style>
</head>
<body>
<div class="sidebar">
  <div class="sidebar-brand">🗺️ <span>EnElMapa</span></div>
  <nav class="sidebar-nav">
    <a class="sidebar-link<%= title === 'Dashboard' ? ' active' : '' %>" href="/admin/dashboard">📊 Dashboard</a>
    <a class="sidebar-link<%= title === 'Categorías' ? ' active' : '' %>" href="/admin/categories">📂 Categorías</a>
    <a class="sidebar-link<%= title === 'Productos' ? ' active' : '' %>" href="/admin/products">🍽️ Productos</a>
    <a class="sidebar-link<%= title === 'Configuración' ? ' active' : '' %>" href="/admin/settings">⚙️ Configuración</a>
    <a class="sidebar-link<%= title === 'Código QR' ? ' active' : '' %>" href="/admin/qr">📱 Código QR</a>
  </nav>
  <div class="sidebar-footer">
    <a href="/s/<%= session.businessSlug %>" target="_blank">Ver menú →</a>
  </div>
</div>
<div class="main">
  <div class="topbar">
    <div class="topbar-title"><%= title %></div>
    <div class="topbar-user">
      <%= session.businessName %>
      <a href="/admin/logout">Salir</a>
    </div>
  </div>
  <div class="content">
