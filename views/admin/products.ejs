<%- include('../partials/admin-head', { title: 'Productos', session }) %>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
  <p style="color:#6B6860"><%= products.length %> productos <span style="font-size:12px;color:#9C9889">— arrastra para reordenar</span></p>
  <button class="btn btn-primary" onclick="openAddProd()">+ Nuevo producto</button>
</div>

<div class="card" style="padding:0;overflow-x:auto">
  <table>
    <thead><tr><th style="width:30px"></th><th style="width:50px"></th><th>Producto</th><th>Categoría</th><th>Precio</th><th style="width:160px">Acciones</th></tr></thead>
    <tbody id="prodBody">
      <% if (products.length === 0) { %>
        <tr><td colspan="6" style="text-align:center;color:#9C9889;padding:30px">No hay productos</td></tr>
      <% } else { %>
        <% products.forEach(p => { %>
          <tr draggable="true" data-id="<%= p.id %>" class="drag-row">
            <td style="cursor:grab;color:#9C9889;font-size:18px;text-align:center">⠿</td>
            <td>
              <% if (p.image) { %>
                <img class="img-thumb" src="<%= p.image %>">
              <% } else { %>
                <div class="img-thumb"></div>
              <% } %>
            </td>
            <td><strong><%= p.name %></strong><br><span style="font-size:12px;color:#9C9889"><%= p.description || '' %></span></td>
            <td><%= p.category_name %></td>
            <td style="font-weight:600;color:#C8956C">
              <%# La condición es "tiene promo", no "tiene precio promocional": un
                  2x1 es una promoción sin cambio de precio, y con la condición
                  vieja no se veía ni su etiqueta ni su estado en esta lista. %>
              <% var conPrecioPromo = p.promo_price !== null && p.promo_price !== undefined; %>
              <% if (conPrecioPromo) { %>
                <span style="text-decoration:line-through;color:#9C9889;font-weight:400">$ <%= Math.round(p.price).toLocaleString('es-CO') %></span><br>
                $ <%= Math.round(p.promo_price).toLocaleString('es-CO') %>
              <% } else { %>
                $ <%= Math.round(p.price).toLocaleString('es-CO') %>
              <% } %>
              <% if (p.promo_label) { %>
                <br><span style="font-size:10px;font-weight:600;border:1px solid #C8956C;border-radius:20px;padding:1px 6px"><%= p.promo_label %></span>
              <% } %>
              <% var et = etiquetaPromo(p.promoEstado); %>
              <%# El estado es lo que evita el reclamo "cargué la promo y no se ve":
                  programada, vencida o fuera de día se dicen, no se adivinan. %>
              <% if (et) { %>
                <br><span style="font-size:10px;font-weight:600;color:<%= et.color %>"><%= et.texto %></span>
              <% } %>
            </td>
            <td>
              <%# `jsonInline` escapa la comilla simple, que es la que delimita este
                  atributo. Con `JSON.stringify` el valor terminaba en el primer
                  apóstrofo del contenido: la descripción de "Cazuela Chidas" dice
                  `pico e' gallo`, y el botón Editar de ese producto no funcionaba. %>
              <button class="btn btn-secondary btn-sm" onclick='editProd(<%- jsonInline({id:p.id,name:p.name,description:p.description||"",price:p.price,category_id:p.category_id,image:p.image||"",is_active:p.is_active,promo_price:p.promo_price,promo_label:p.promo_label||"",promo_from:aFechaTexto(p.promo_from),promo_to:aFechaTexto(p.promo_to),promo_days:p.promo_days||"1111111"}) %>)'>Editar</button>
              <button class="btn btn-danger btn-sm" onclick="deleteProd(<%= p.id %>, '<%= p.name.replace(/'/g,"\\'") %>')">Eliminar</button>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<div class="modal-overlay" id="prodModal">
  <div class="modal">
    <h3 id="prodModalTitle">Nuevo producto</h3>
    <form id="prodForm" enctype="multipart/form-data">
      <input type="hidden" id="prodId">
      <div class="form-group">
        <label>Categoría</label>
        <select id="prodCat" required>
          <% categories.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Nombre</label>
        <input type="text" id="prodName" required>
      </div>
      <div class="form-group">
        <label>Descripción</label>
        <textarea id="prodDesc"></textarea>
      </div>
      <div class="form-group">
        <label>Precio (COP)</label>
        <input type="number" id="prodPrice" required min="0">
      </div>
      <div class="form-group">
        <label>Imagen</label>
        <input type="file" id="prodImage" accept="image/*">
        <img id="prodImgPreview" class="img-preview" style="display:none">
      </div>
      <div class="form-group" id="prodActiveGroup" style="display:none">
        <label style="display:flex;align-items:center;gap:10px">
          Activo
          <label class="toggle"><input type="checkbox" id="prodActive" checked><span class="toggle-slider"></span></label>
        </label>
      </div>

      <%# === Promoción ===
          Nada se esconde. La primera versión mostraba sólo el precio promocional y
          revelaba el resto al escribirlo, para no llenar el formulario de campos
          inertes; el resultado fue que nadie encontraba la etiqueta y no había forma
          de descubrir que se podía cargar un "2x1".

          Hay promoción con precio, con etiqueta, o con las dos:
            - baja de precio  -> precio promocional (el tachado sale solo)
            - 2x1, "martes de alitas" -> sólo etiqueta; el precio unitario no cambia
          Vacíos los dos, no hay promoción y se limpian fechas y días. %>
      <fieldset style="border:1px solid #E8E5DE;border-radius:8px;padding:14px;margin-bottom:16px">
        <legend style="font-size:13px;font-weight:600;color:#6B6860;padding:0 6px">Promoción</legend>
        <p style="font-size:12px;color:#6B6860;margin:0 0 14px">
          Podés bajar el precio, poner una etiqueta como <strong>2x1</strong>, o las dos cosas.
          Dejá todo vacío para que el producto no tenga promoción.
        </p>

        <div class="form-group">
          <label>Etiqueta <span style="font-weight:400;color:#9C9889">— lo que ve el cliente en el menú</span></label>
          <input type="text" id="promoLabel" maxlength="40" placeholder="2x1">
          <%# Atajos con los casos que más se piden. Escriben la etiqueta y, cuando
              corresponde, calculan el precio: un "-30%" que obliga al dueño a sacar
              el 30% con la calculadora es una invitación a equivocarse. %>
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px">
            <button type="button" class="btn btn-secondary btn-sm" data-etiqueta="2x1">2x1</button>
            <button type="button" class="btn btn-secondary btn-sm" data-descuento="10">-10%</button>
            <button type="button" class="btn btn-secondary btn-sm" data-descuento="20">-20%</button>
            <button type="button" class="btn btn-secondary btn-sm" data-descuento="30">-30%</button>
            <button type="button" class="btn btn-secondary btn-sm" data-descuento="50">-50%</button>
          </div>
        </div>

        <div class="form-group">
          <label>Precio promocional (COP) <span style="font-weight:400;color:#9C9889">— opcional; vacío deja el precio normal</span></label>
          <input type="number" id="promoPrice" min="0" placeholder="Sin cambio de precio">
          <p style="font-size:11px;color:#9C9889;margin-top:6px" id="promoAyudaPrecio">
            Tiene que ser menor que el precio normal. Si lo llenás, el menú muestra el precio
            viejo tachado.
          </p>
        </div>

        <div class="form-group">
          <label>Vigencia</label>
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px">
            <button type="button" class="btn btn-secondary btn-sm" data-preset="fija">Fija</button>
            <button type="button" class="btn btn-secondary btn-sm" data-preset="semana">Esta semana</button>
            <button type="button" class="btn btn-secondary btn-sm" data-preset="mes">Este mes</button>
          </div>
          <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
            <label style="font-size:12px;color:#6B6860">Desde <input type="date" id="promoFrom"></label>
            <label style="font-size:12px;color:#6B6860">Hasta <input type="date" id="promoTo"></label>
          </div>
          <p style="font-size:11px;color:#9C9889;margin-top:6px">Sin fechas, la promoción no vence.</p>
        </div>

        <div class="form-group" style="margin-bottom:0">
          <label>Días de la semana</label>
          <div id="promoDias" style="display:flex;gap:6px;flex-wrap:wrap"></div>
          <p style="font-size:11px;color:#9C9889;margin-top:6px">Tiene que quedar al menos uno marcado.</p>
        </div>
      </fieldset>

      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('prodModal').classList.remove('open')">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar</button>
      </div>
    </form>
  </div>
</div>

<style>
.drag-row { transition: background 0.15s; }
.drag-row.dragging { opacity: 0.4; background: #F2EFEA; }
.drag-row.drag-over { border-top: 3px solid #C8956C; }
</style>

<script>
var dragRow = null;

document.querySelectorAll('.drag-row').forEach(function(row) {
  row.addEventListener('dragstart', function(e) {
    dragRow = this;
    this.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
  });
  row.addEventListener('dragend', function() {
    this.classList.remove('dragging');
    document.querySelectorAll('.drag-row').forEach(function(r) { r.classList.remove('drag-over'); });
    saveProdOrder();
  });
  row.addEventListener('dragover', function(e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    if (this !== dragRow) {
      document.querySelectorAll('.drag-row').forEach(function(r) { r.classList.remove('drag-over'); });
      this.classList.add('drag-over');
    }
  });
  row.addEventListener('drop', function(e) {
    e.preventDefault();
    if (this !== dragRow) {
      var tbody = document.getElementById('prodBody');
      var rows = Array.from(tbody.querySelectorAll('.drag-row'));
      var fromIdx = rows.indexOf(dragRow);
      var toIdx = rows.indexOf(this);
      if (fromIdx < toIdx) {
        tbody.insertBefore(dragRow, this.nextSibling);
      } else {
        tbody.insertBefore(dragRow, this);
      }
    }
  });
});

function saveProdOrder() {
  var rows = document.querySelectorAll('.drag-row');
  var order = [];
  rows.forEach(function(r) { order.push(parseInt(r.dataset.id)); });
  apiFetch('/api/products/reorder', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ order: order })
  });
}

// === Promoción ===
//
// El orden de los días es el mismo de toda la app: posición 0 = Domingo, igual
// que `business_hours.day_index` y que `Date.getDay()`. Cambiarlo acá y no en el
// resto sería un corrimiento silencioso: la promo del martes se mostraría el
// lunes.
var DIAS_PROMO = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];

(function construirDias() {
  var cont = document.getElementById('promoDias');
  DIAS_PROMO.forEach(function (nombre, i) {
    var lbl = document.createElement('label');
    lbl.style.cssText = 'display:flex;align-items:center;gap:4px;font-size:12px;color:#6B6860;cursor:pointer';
    var chk = document.createElement('input');
    chk.type = 'checkbox';
    chk.className = 'promo-dia';
    chk.dataset.indice = i;
    chk.checked = true;
    lbl.appendChild(chk);
    lbl.appendChild(document.createTextNode(nombre));
    cont.appendChild(lbl);
  });
})();

function diasSeleccionados() {
  var chks = document.querySelectorAll('.promo-dia');
  var out = '';
  for (var i = 0; i < chks.length; i++) out += chks[i].checked ? '1' : '0';
  return out;
}

function cargarPromo(p) {
  document.getElementById('promoPrice').value = (p.promo_price === null || p.promo_price === undefined) ? '' : p.promo_price;
  document.getElementById('promoLabel').value = p.promo_label || '';
  document.getElementById('promoFrom').value = p.promo_from || '';
  document.getElementById('promoTo').value = p.promo_to || '';

  var dias = p.promo_days || '1111111';
  document.querySelectorAll('.promo-dia').forEach(function (chk, i) {
    chk.checked = dias[i] === '1';
  });

}

// Atajos de etiqueta. "2x1" es sólo etiqueta —el precio unitario no cambia—, y los
// de porcentaje además CALCULAN el precio promocional a partir del precio normal:
// hacerle sacar el 30% con la calculadora al dueño es una invitación a equivocarse,
// y un precio promocional mayor al normal lo rechaza el servidor.
document.querySelectorAll('[data-etiqueta], [data-descuento]').forEach(function (btn) {
  btn.addEventListener('click', function () {
    var etiqueta = document.getElementById('promoLabel');
    var precioPromo = document.getElementById('promoPrice');

    if (this.dataset.etiqueta) {
      etiqueta.value = this.dataset.etiqueta;
      // Un 2x1 no cambia el precio unitario, así que se limpia: si quedara un
      // precio de un atajo anterior, el menú mostraría un tachado que no
      // corresponde.
      precioPromo.value = '';
      return;
    }

    var pct = Number(this.dataset.descuento);
    etiqueta.value = '-' + pct + '%';

    var normal = Number(document.getElementById('prodPrice').value);
    if (!Number.isFinite(normal) || normal <= 0) {
      precioPromo.value = '';
      return;
    }
    // Se redondea a la unidad: en pesos colombianos no existen los centavos y un
    // "$ 13.999,99" en el menú se lee como un error.
    precioPromo.value = Math.round(normal * (100 - pct) / 100);
  });
});

// Los atajos de vigencia. Se calculan en el navegador, con la fecha del usuario:
// es sólo para llenar los dos campos, y lo que decide si la promo está vigente
// es siempre el servidor, en la zona del negocio.
document.querySelectorAll('[data-preset]').forEach(function (btn) {
  btn.addEventListener('click', function () {
    var desde = document.getElementById('promoFrom');
    var hasta = document.getElementById('promoTo');
    var hoy = new Date();
    var iso = function (d) {
      return d.getFullYear() + '-' +
        String(d.getMonth() + 1).padStart(2, '0') + '-' +
        String(d.getDate()).padStart(2, '0');
    };

    if (this.dataset.preset === 'fija') {
      desde.value = '';
      hasta.value = '';
      return;
    }

    desde.value = iso(hoy);
    if (this.dataset.preset === 'semana') {
      // Hasta el domingo de esta semana. Si hoy ES domingo, la promo dura ese
      // día: "esta semana" no puede terminar antes de empezar.
      var faltan = (7 - hoy.getDay()) % 7;
      var fin = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() + faltan);
      hasta.value = iso(fin);
    } else {
      // Último día de este mes: día 0 del siguiente.
      hasta.value = iso(new Date(hoy.getFullYear(), hoy.getMonth() + 1, 0));
    }
  });
});

function openAddProd() {
  document.getElementById('prodModalTitle').textContent = 'Nuevo producto';
  document.getElementById('prodId').value = '';
  document.getElementById('prodName').value = '';
  document.getElementById('prodDesc').value = '';
  document.getElementById('prodPrice').value = '';
  document.getElementById('prodCat').selectedIndex = 0;
  document.getElementById('prodImgPreview').style.display = 'none';
  document.getElementById('prodActiveGroup').style.display = 'none';
  cargarPromo({});
  document.getElementById('prodModal').classList.add('open');
}

function editProd(p) {
  document.getElementById('prodModalTitle').textContent = 'Editar producto';
  document.getElementById('prodId').value = p.id;
  document.getElementById('prodName').value = p.name;
  document.getElementById('prodDesc').value = p.description || '';
  document.getElementById('prodPrice').value = p.price;
  document.getElementById('prodCat').value = p.category_id;
  document.getElementById('prodActive').checked = p.is_active === 1;
  document.getElementById('prodActiveGroup').style.display = '';
  if (p.image) {
    document.getElementById('prodImgPreview').src = p.image;
    document.getElementById('prodImgPreview').style.display = '';
  } else {
    document.getElementById('prodImgPreview').style.display = 'none';
  }
  cargarPromo(p);
  document.getElementById('prodModal').classList.add('open');
}

document.getElementById('prodForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  var id = document.getElementById('prodId').value;
  var fd = new FormData();
  fd.append('name', document.getElementById('prodName').value);
  fd.append('description', document.getElementById('prodDesc').value);
  fd.append('price', document.getElementById('prodPrice').value);
  fd.append('category_id', document.getElementById('prodCat').value);
  if (id) fd.append('is_active', document.getElementById('prodActive').checked ? '1' : '0');
  var file = document.getElementById('prodImage').files[0];
  if (file) fd.append('image', file);

  // Los cinco campos de promo van SIEMPRE, incluso vacíos: mandar sólo los que
  // tienen valor haría imposible quitar una promoción desde el formulario.
  fd.append('promo_price', document.getElementById('promoPrice').value);
  fd.append('promo_label', document.getElementById('promoLabel').value);
  fd.append('promo_from', document.getElementById('promoFrom').value);
  fd.append('promo_to', document.getElementById('promoTo').value);
  fd.append('promo_days', diasSeleccionados());

  var url = id ? '/api/products/' + id : '/api/products';
  var method = id ? 'PUT' : 'POST';
  await apiFetchThenReload(url, { method: method, body: fd });
});

async function deleteProd(id, name) {
  if (!confirm('Eliminar "' + name + '"?')) return;
  await apiFetchThenReload('/api/products/' + id, { method: 'DELETE' });
}

document.getElementById('prodImage').addEventListener('change', function() {
  var file = this.files[0];
  if (file) {
    var preview = document.getElementById('prodImgPreview');
    preview.src = URL.createObjectURL(file);
    preview.style.display = '';
  }
});
</script>

<%- include('../partials/admin-foot') %>
