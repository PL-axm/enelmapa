<%- include('../partials/admin-head', { title: 'Configuración', session }) %>

<div id="saveAlert" class="alert alert-success" style="display:none">Cambios guardados correctamente</div>

<form id="settingsForm" enctype="multipart/form-data">
<div class="card">
  <h3>Información general</h3>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
    <div class="form-group">
      <label>Nombre del negocio</label>
      <input type="text" name="name" value="<%= business.name %>" required>
    </div>
    <div class="form-group">
      <label>Dirección</label>
      <input type="text" name="address" value="<%= business.address %>">
    </div>
    <div class="form-group">
      <label>Teléfono</label>
      <input type="text" name="phone" value="<%= business.phone %>">
    </div>
    <div class="form-group">
      <label>WhatsApp (sin +)</label>
      <input type="text" name="whatsapp" value="<%= business.whatsapp %>" placeholder="573001234567">
    </div>
    <div class="form-group">
      <label>Instagram (usuario)</label>
      <input type="text" name="instagram" value="<%= business.instagram %>" placeholder="mi_negocio">
    </div>
    <div class="form-group">
      <label>Facebook (usuario)</label>
      <input type="text" name="facebook" value="<%= business.facebook %>" placeholder="mi_negocio">
    </div>
    <div class="form-group">
      <label>TikTok (usuario)</label>
      <input type="text" name="tiktok" value="<%= business.tiktok || '' %>">
    </div>
    <div class="form-group">
      <label style="display:flex;align-items:center;gap:10px;margin-top:22px">
        ¿Está abierto?
        <label class="toggle"><input type="checkbox" name="is_open" <%= business.is_open ? 'checked' : '' %>><span class="toggle-slider"></span></label>
      </label>
    </div>
  </div>
</div>

<div class="card">
  <h3>Tema del menú</h3>
  <p style="font-size:13px;color:#6B6860;margin-bottom:16px">Elige el color de fondo de tu menú digital</p>
  <%# Las opciones salen de theme/ (paletasParaUI). Antes estaban escritas una
      por una acá, con el fondo y el color de texto de cada tema copiados a
      mano: era la cuarta copia de la misma información y la razón de que la
      lista se desincronizara del validador. Agregar una paleta ahora es tocar
      un solo archivo. %>
  <div style="display:flex;gap:12px;flex-wrap:wrap">
    <% paletas.forEach(function(p) { %>
      <% var elegida = (business.menu_theme || paletaPorDefecto) === p.id; %>
      <label style="cursor:pointer;text-align:center">
        <input type="radio" name="menu_theme" value="<%= p.id %>" <%= elegida ? 'checked' : '' %> style="display:none">
        <div class="theme-option" data-borde="<%= p.borde %>"
             style="background:<%= p.fondo %>;color:<%= p.texto %>;border:3px solid <%= elegida ? '#C8956C' : p.borde %>">Aa</div>
        <span style="font-size:12px;color:#6B6860"><%= p.nombre %></span>
      </label>
    <% }) %>
  </div>
  <style>.theme-option{width:60px;height:60px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;margin-bottom:4px;transition:border-color .2s;}</style>

  <%# La vista previa de cada escala usa el propio factor para dibujar el "Aa", así
      que lo que se ve es literalmente lo que va a pasar en el menú. Si mañana se
      cambia un factor en theme/escalas.js, esto lo refleja sin tocar nada. %>
  <h3 style="margin-top:28px">Tamaño del texto</h3>
  <p style="font-size:13px;color:#6B6860;margin-bottom:16px">Afecta los títulos de categoría, los nombres, las descripciones y los precios de tu menú</p>
  <div style="display:flex;gap:12px;flex-wrap:wrap">
    <% escalas.forEach(function(e) { %>
      <% var elegida = (business.menu_scale || escalaPorDefecto) === e.id; %>
      <label style="cursor:pointer;text-align:center">
        <input type="radio" name="menu_scale" value="<%= e.id %>" <%= elegida ? 'checked' : '' %> style="display:none">
        <div class="scale-option" style="border-color:<%= elegida ? '#C8956C' : '#E8E5DE' %>">
          <span style="font-size:<%= Math.round(20 * e.factor) %>px">Aa</span>
        </div>
        <span style="font-size:12px;color:#6B6860;display:block"><%= e.nombre %></span>
        <span style="font-size:11px;color:#9C9889"><%= e.descripcion %></span>
      </label>
    <% }) %>
  </div>
  <style>.scale-option{width:60px;height:60px;border-radius:10px;border:3px solid #E8E5DE;background:#FAFAF7;color:#1A1A18;display:flex;align-items:center;justify-content:center;font-weight:700;margin-bottom:4px;transition:border-color .2s;}</style>

  <%# Apagar la sección no borra nada: los precios promocionales cargados siguen
      en cada producto y vuelven a mostrarse al encenderla. %>
  <h3 style="margin-top:28px">Promociones</h3>
  <p style="font-size:13px;color:#6B6860;margin-bottom:16px">
    Con esto encendido, los productos con una promoción vigente aparecen en una sección
    al principio de tu menú y muestran su precio rebajado. Apagado, tu menú se ve sin
    ninguna promoción — los precios promocionales que cargaste quedan guardados y vuelven
    a mostrarse cuando lo enciendas.
  </p>
  <label style="display:flex;align-items:center;gap:10px;font-size:14px">
    Mostrar promociones en el menú
    <label class="toggle">
      <input type="checkbox" name="promos_enabled" <%= business.promos_enabled ? 'checked' : '' %>>
      <span class="toggle-slider"></span>
    </label>
  </label>
  <script>
    document.querySelectorAll('input[name="menu_scale"]').forEach(function (r) {
      r.addEventListener('change', function () {
        document.querySelectorAll('.scale-option').forEach(function (d) {
          d.style.borderColor = '#E8E5DE';
        });
        this.parentElement.querySelector('.scale-option').style.borderColor = '#C8956C';
      });
    });
  </script>
  <%# Al deseleccionar se vuelve al borde de la propia paleta (data-borde), no a
      uno fijo: el código anterior reseteaba todo a #E8E5DE, que sobre las
      paletas oscuras dejaba un marco claro donde antes no había ninguno. %>
  <script>
    document.querySelectorAll('input[name="menu_theme"]').forEach(function (r) {
      r.addEventListener('change', function () {
        document.querySelectorAll('.theme-option').forEach(function (d) {
          d.style.borderColor = d.dataset.borde;
        });
        this.parentElement.querySelector('.theme-option').style.borderColor = '#C8956C';
      });
    });
  </script>
</div>

<div class="card">
  <h3>Imágenes</h3>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
    <div class="form-group">
      <label>Banner</label>
      <input type="file" name="banner" accept="image/*">
      <% if (business.banner_img) { %>
        <img src="<%= business.banner_img %>" class="img-preview" style="width:100%;height:100px">
      <% } %>
    </div>
    <div class="form-group">
      <label>Logo</label>
      <input type="file" name="logo" accept="image/*">
      <% if (business.logo_img) { %>
        <img src="<%= business.logo_img %>" class="img-preview" style="width:80px;height:80px">
      <% } %>
    </div>
  </div>
</div>

<div class="card">
  <h3>Horarios de atención</h3>
  <div style="display:grid;grid-template-columns:100px 1fr 1fr auto;gap:10px;padding-bottom:8px;border-bottom:2px solid #E8E5DE">
    <span style="font-size:12px;font-weight:600;color:#9C9889">DÍA</span>
    <span style="font-size:12px;font-weight:600;color:#9C9889">APERTURA</span>
    <span style="font-size:12px;font-weight:600;color:#9C9889">CIERRE</span>
    <span style="font-size:12px;font-weight:600;color:#9C9889">CERRADO</span>
  </div>
  <% hours.forEach(h => { %>
    <div style="display:grid;grid-template-columns:100px 1fr 1fr auto;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid #E8E5DE">
      <span style="font-size:14px"><%= h.day_name %></span>
      <input type="time" class="hour-open" data-day="<%= h.day_index %>" value="<%= h.open_time %>" style="padding:6px 8px;border:1px solid #E8E5DE;border-radius:6px;font-size:13px">
      <input type="time" class="hour-close" data-day="<%= h.day_index %>" value="<%= h.close_time %>" style="padding:6px 8px;border:1px solid #E8E5DE;border-radius:6px;font-size:13px">
      <label class="toggle"><input type="checkbox" class="hour-closed" data-day="<%= h.day_index %>" <%= h.is_closed ? 'checked' : '' %>><span class="toggle-slider"></span></label>
    </div>
  <% }) %>
</div>

<div style="display:flex;justify-content:flex-end;gap:12px;margin-top:20px">
  <a href="/s/<%= session.businessSlug %>" target="_blank" class="btn btn-secondary">Ver menú</a>
  <button type="submit" class="btn btn-primary">Guardar cambios</button>
</div>
</form>

<script>
document.getElementById('settingsForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  var fd = new FormData(this);

  var hoursData = [];
  document.querySelectorAll('.hour-open').forEach(function(el) {
    var day = parseInt(el.dataset.day);
    hoursData.push({
      day_index: day,
      open_time: el.value,
      close_time: document.querySelector('.hour-close[data-day="' + day + '"]').value,
      is_closed: document.querySelector('.hour-closed[data-day="' + day + '"]').checked
    });
  });
  fd.append('hours', JSON.stringify(hoursData));

  // Acá no se recarga: la página ya refleja lo que el usuario escribió, y
  // recargar le haría perder el scroll en un formulario largo. Sólo se
  // confirma; si falla, apiFetch deja el error arriba.
  if (await apiFetch('/api/settings', { method: 'POST', body: fd })) {
    document.getElementById('saveAlert').style.display = '';
    setTimeout(function() { document.getElementById('saveAlert').style.display = 'none'; }, 3000);
  }
});
</script>

<%- include('../partials/admin-foot') %>
