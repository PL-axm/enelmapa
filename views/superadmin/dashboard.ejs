<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#1a1a2e;color:#e0e0e0;min-height:100vh}
.topbar{background:#16213e;padding:16px 30px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #2a2a4a}
.topbar h1{color:#e94560;font-size:20px}
.topbar a{color:#8a8a9a;text-decoration:none;font-size:13px}
.topbar a:hover{color:#e94560}
.container{max-width:1100px;margin:30px auto;padding:0 20px}
.header-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}
.header-row h2{font-size:18px;color:#ccc}
.btn{padding:10px 20px;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;text-decoration:none;display:inline-block}
.btn-primary{background:#e94560;color:#fff}
.btn-primary:hover{background:#c73e54}
.btn-sm{padding:6px 14px;font-size:12px}
.btn-secondary{background:#2a2a4a;color:#ccc}
.btn-danger{background:#dc3545;color:#fff}
.card{background:#16213e;border-radius:10px;overflow:hidden;margin-bottom:16px}
table{width:100%;border-collapse:collapse}
th{text-align:left;padding:14px 16px;font-size:12px;text-transform:uppercase;color:#8a8a9a;background:#0f3460;letter-spacing:.5px}
td{padding:12px 16px;border-top:1px solid #2a2a4a;font-size:14px}
.slug{color:#e94560;font-weight:600}
.badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600}
.badge-open{background:#28a74520;color:#28a745}
.badge-closed{background:#dc354520;color:#dc3545}
.actions{display:flex;gap:8px}
.empty{text-align:center;padding:40px;color:#8a8a9a}
</style>

<div class="topbar">
  <h1>EnElMapa — Super Admin</h1>
  <a href="/superadmin/logout">Cerrar sesión</a>
</div>

<div class="container">
  <div class="header-row">
    <h2>Negocios registrados (<%= businesses.length %>)</h2>
    <a href="/superadmin/create" class="btn btn-primary">+ Nuevo negocio</a>
  </div>

  <div class="card">
    <table>
      <thead>
        <tr>
          <th>Negocio</th>
          <th>Slug</th>
          <th>Admin</th>
          <th>Categorías</th>
          <th>Productos</th>
          <th>Estado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (businesses.length === 0) { %>
          <tr><td colspan="7" class="empty">No hay negocios registrados</td></tr>
        <% } else { %>
          <% businesses.forEach(b => { %>
            <tr>
              <td><strong><%= b.name %></strong></td>
              <td><span class="slug"><%= b.slug %>.enelmapa.co</span></td>
              <td style="font-size:12px;color:#8a8a9a"><%= b.admin_email || '—' %></td>
              <td><%= b.cat_count %></td>
              <td><%= b.prod_count %></td>
              <td><span class="badge <%= b.is_open ? 'badge-open' : 'badge-closed' %>"><%= b.is_open ? 'Abierto' : 'Cerrado' %></span></td>
              <td>
                <div class="actions">
                  <a href="/s/<%= b.slug %>" target="_blank" class="btn btn-secondary btn-sm">Ver</a>
                  <a href="/superadmin/edit/<%= b.id %>" class="btn btn-secondary btn-sm">Editar</a>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
